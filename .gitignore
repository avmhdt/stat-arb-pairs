# Data: never commit raw or licensed data
data/
*.parquet
*.feather
*.h5
*.itch
*.pcap
*.gz
*.zst

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# C++ / Rust / CUDA builds
build/
cmake-build-*/
target/
*.o
*.obj
*.so
*.dll
*.pyd
*.exe

# Editors, OS, secrets
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# Local build spec (kept out of the public repo)
SPEC.html

# Run logs and per-run outputs (row-level outputs may derive from licensed data)
logs/
results/runs/
# The data/ rule above would also hide these code and test packages (spec section 6)
!src/statarb/data/
!tests/data/
