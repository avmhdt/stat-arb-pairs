# .env.example (copy to .env and fill in; never commit .env)

# --- Required ---
SEC_USER_AGENT=                  # REQUIRED. "Full Name email@example.com" for SEC EDGAR requests

# --- Equity data provider (D-01) ---
STATARB_EQUITY_PROVIDER=sharadar # optional. sharadar | crsp | free (default: sharadar per D-01; free = prototype, survivorship-biased)
WRDS_USERNAME=                   # optional; only for pre-1998 history (provider=crsp). Password lives only in ~/.pgpass
SHARADAR_API_KEY=                # REQUIRED: Sharadar's direct API (owner's subscription, P-06)
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq  # owner-supplied Stooq bulk daily snapshot (through 2026-10-30, P-12); read once into data/ Parquet. Native Windows: E:\trading-strategy-brainstorm\data\stooq
TIINGO_API_KEY=                  # optional, normally unneeded. Extra free cross-check only

# --- Intraday variant (Could) ---
ALPACA_API_KEY_ID=               # optional. Alpaca market-data key id (paper account is enough)
ALPACA_API_SECRET_KEY=           # optional. Alpaca market-data secret
ALPACA_DATA_FEED=iex             # optional. iex on the free plan; sip only if a paid plan is approved

# --- Borrow costs ---
STATARB_BORROW_SOURCE=assumed    # optional. assumed | ibkr (ibkr = snapshot collector, forward-only)

# --- Paths and logging ---
DATA_ROOT=~/data/stat-arb-pairs  # WSL: data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader). Native Windows: leave empty (~ would point to C:)
STATARB_DATA_DIR=                # optional. Root for raw/, interim/, processed/; empty = DATA_ROOT, or ./data when DATA_ROOT is empty
STATARB_RESULTS_DIR=./results    # optional. Trial log and run outputs
STATARB_LOG_LEVEL=INFO           # optional. DEBUG | INFO | WARNING
# Binance public data needs no key.
